#!/bin/bash
set -euo pipefail

CONFIG_FILE="/etc/auto_xdp/auto_xdp.env"
TOML_CONFIG="/etc/auto_xdp/config.toml"
CONFIG_DIR="/etc/auto_xdp"
RELAY_GROUP="auto-xdp"
RELAY_GROUP_MARKER="${CONFIG_DIR}/.relay-group-created"
RUN_STATE_DIR="/run/auto_xdp"
BPF_PIN_DIR="/sys/fs/bpf/xdp_fw"
INSTALL_ROOT="/usr/local/lib/auto_xdp"
INSTALL_DIR="${INSTALL_ROOT}/current"
PYTHON_LIB_DIR="${INSTALL_DIR}/python"
HANDLERS_DIR="/etc/auto_xdp/handlers"
NFT_FAMILY="inet"
NFT_TABLE="auto_xdp"
NFT_CHAIN="input"
RUNNER_SCRIPT="${INSTALL_DIR}/auto_xdp_start.sh"
SYNC_SCRIPT="${INSTALL_DIR}/xdp_port_sync.py"
RELAY_SCRIPT="${INSTALL_DIR}/pkt_relay.py"
AXDP_CMD="/usr/local/bin/axdp"
SERVICE_NAME="xdp-port-sync"
RELAY_SERVICE_NAME="auto-xdp-relay"
SYSTEMD_RUN_DIR="${SYSTEMD_RUN_DIR:-/run/systemd/system}"
SYSTEMD_UNIT_DIR="${SYSTEMD_UNIT_DIR:-/etc/systemd/system}"
OPENRC_INIT_DIR="${OPENRC_INIT_DIR:-/etc/init.d}"
OPENRC_RUN_DIR="${OPENRC_RUN_DIR:-/run}"
AUTO_XDP_PROC_ROOT="${AUTO_XDP_PROC_ROOT:-/proc}"
RAW_URL="https://raw.githubusercontent.com/Kookiejarz/auto_xdp/main"

PORTS_WATCH=0
PORTS_INTERVAL=2
IFACE=""
BACKEND=""

usage() {
    cat <<'EOF'
Usage: axdp [command] [options]

Commands:
  stats [args...]        Show Auto XDP statistics
  tui [args...]          Open htop-like live TUI
  watch [args...]        Shorthand for: stats --watch
  ports [args...]        Show currently allowed TCP/UDP ports
  exposure               Show live service-aware exposure decisions
  explain PROTO/PORT     Explain one runtime endpoint authorization decision
  backend                Show active backend and runtime attachment state
  sync [args...]         Run one sync pass with automatic backend selection
  check-update [args...] Compare installed files against GitHub and update
  log-level [LVL]        Show or change daemon log level
  under-attack [on|off] Show or change under-attack mode
  start                  Start the installed service
  stop                   Stop the installed service
  restart                Restart the installed service
  status                 Show service status
  uninstall [IFACE...]   Completely remove Auto XDP from this host
  config show            Show current TOML config
  config init            Create default config.toml (if missing)
  trust list             List trusted source IPs/CIDRs
  trust add CIDR [LABEL] Add a trusted source CIDR
  trust del CIDR         Remove a trusted source CIDR
  acl list               List per-CIDR port ACL rules
  acl add PROTO CIDR PORT...  Add an ACL rule (proto: tcp|udp)
  acl del PROTO CIDR     Remove an ACL rule
  policy grants          List approved service exposure grants
  approval list          List exposure approval requests
  approval history       Show immutable approval audit history
  approval request ...   Create an exposure approval request
  approval approve ID    Approve a request and apply its grant
  approval reject ID     Reject a request
  approval revoke ID     Revoke a request's applied grant
  approval-api           Run the root-only Unix-socket management API
  slot list              List loaded and available protocol slot handlers
  slot load NAME         Load built-in handler: gre, esp, sctp
  slot load PROTO PATH   Load custom handler .o or compile/load .c for IP proto number
  slot unload PROTO      Remove handler from slot
  port-handler list                          List loaded TCP/UDP port handlers
  port-handler load tcp|udp PORT PATH        Load custom handler .o or compile/load .c for a port
  port-handler unload tcp|udp PORT           Remove handler from a port
  exclude list                              List discovery exclusions
  exclude port add PORT [PORT...]           Exclude port(s) from discovery
  exclude port del PORT [PORT...]           Remove port exclusion(s)
  exclude src add CIDR [CIDR...]            Exclude src IP/CIDR(s) from discovery
  exclude src del CIDR [CIDR...]            Remove src IP/CIDR exclusion(s)
  help                   Show this help

Stats options:
  --watch              Refresh continuously
  --rates              Show packet/bit rate deltas
  --interval SEC       Refresh / delta interval in seconds (default: 1)
  --interface IFACE    Override interface autodetection

TUI options:
  --interval SEC       Refresh maps/ports/stats interval (default: 2)
  --socket PATH        pkt_relay Unix socket path
  --interface IFACE    Override interface autodetection

Ports options:
  --watch              Refresh continuously and detect changes
  --interval SEC       Refresh interval in seconds (default: 2)

Check-update options:
  --force              Apply all updates without prompting

With no command, axdp runs: stats
EOF
}

run_service_cmd() {
    local action="$1"

    if command -v systemctl >/dev/null 2>&1 && [[ -d "$SYSTEMD_RUN_DIR" ]]; then
        systemctl "$action" "$SERVICE_NAME"
        if systemctl list-unit-files "${RELAY_SERVICE_NAME}.service" >/dev/null 2>&1; then
            systemctl "$action" "$RELAY_SERVICE_NAME" || true
        else
            echo "Relay service not installed yet. Re-run setup_xdp.sh --force to install ${RELAY_SERVICE_NAME}." >&2
        fi
        return 0
    fi

    if command -v rc-service >/dev/null 2>&1; then
        rc-service "$SERVICE_NAME" "$action"
        rc-service "$RELAY_SERVICE_NAME" "$action" 2>/dev/null || \
            echo "Relay service not installed yet. Re-run setup_xdp.sh --force to install ${RELAY_SERVICE_NAME}." >&2
        return 0
    fi

    echo "No supported init system detected for service control." >&2
    return 2
}

run_status() {
    local service_status=0 backend_status=0
    run_service_cmd status || service_status=$?
    printf '\nAuto XDP protection health\n'
    run_backend "$@" || backend_status=$?
    [[ $backend_status -eq 0 && ( $service_status -eq 0 || $service_status -eq 2 ) ]]
}

_remove_owned_tree() {
    local path="${1%/}" expected_base="$2"
    [[ ! -e "$path" && ! -L "$path" ]] && return 0
    if [[ "$path" != /* || "$path" == "/" || "${path##*/}" != "$expected_base" ]]; then
        printf 'Refusing to remove unexpected directory: %s\n' "$path" >&2
        return 1
    fi
    rm -rf -- "$path"
}

_remove_owned_file() {
    local path="$1" expected_base="$2"
    [[ ! -e "$path" && ! -L "$path" ]] && return 0
    if [[ "$path" != /* || "${path##*/}" != "$expected_base" ]]; then
        printf 'Refusing to remove unexpected file: %s\n' "$path" >&2
        return 1
    fi
    rm -f -- "$path"
}

_relay_group_has_members() {
    local entry gid members user_name user_gid
    entry=$(getent group "$RELAY_GROUP" 2>/dev/null) || return 1
    gid=$(printf '%s\n' "$entry" | cut -d: -f3)
    members=$(printf '%s\n' "$entry" | cut -d: -f4)
    [[ -n "$members" ]] && return 0

    while IFS=: read -r user_name _ _ user_gid _; do
        [[ -n "$user_name" && "$user_gid" == "$gid" ]] && return 0
    done < <(getent passwd 2>/dev/null || true)
    return 1
}

_remove_owned_relay_group() {
    # The marker distinguishes a group created by this installer from a
    # pre-existing administrator-owned group with the same name.
    [[ -f "$RELAY_GROUP_MARKER" && ! -L "$RELAY_GROUP_MARKER" ]] || return 0
    if ! getent group "$RELAY_GROUP" >/dev/null 2>&1; then
        _remove_owned_file "$RELAY_GROUP_MARKER" ".relay-group-created"
        return $?
    fi
    if _relay_group_has_members; then
        printf 'Preserving %s group because it has members.\n' "$RELAY_GROUP" >&2
        _remove_owned_file "$RELAY_GROUP_MARKER" ".relay-group-created"
        return $?
    fi

    if command -v groupdel >/dev/null 2>&1; then
        groupdel "$RELAY_GROUP" >/dev/null 2>&1 || return 1
    elif command -v delgroup >/dev/null 2>&1; then
        delgroup "$RELAY_GROUP" >/dev/null 2>&1 || return 1
    else
        printf 'Cannot remove installer-owned group %s: groupdel/delgroup not found.\n' "$RELAY_GROUP" >&2
        return 1
    fi
    _remove_owned_file "$RELAY_GROUP_MARKER" ".relay-group-created"
}

_runtime_process_matches() {
    local pid="$1" arg
    [[ -r "$AUTO_XDP_PROC_ROOT/$pid/cmdline" ]] || return 1
    while IFS= read -r -d '' arg; do
        case "$arg" in
            "$RUNNER_SCRIPT"|"$SYNC_SCRIPT"|"$RELAY_SCRIPT")
                return 0
                ;;
        esac
    done < "$AUTO_XDP_PROC_ROOT/$pid/cmdline"
    return 1
}

_stop_runtime_processes() {
    local proc_dir pid arg matched
    local -a argv=()
    local -a matched_pids=()

    for proc_dir in "$AUTO_XDP_PROC_ROOT"/[0-9]*; do
        [[ -r "$proc_dir/cmdline" ]] || continue
        pid=${proc_dir##*/}
        [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue

        argv=()
        while IFS= read -r -d '' arg; do
            argv+=("$arg")
        done < "$proc_dir/cmdline"

        matched=0
        for arg in "${argv[@]}"; do
            case "$arg" in
                "$RUNNER_SCRIPT"|"$SYNC_SCRIPT"|"$RELAY_SCRIPT") matched=1; break ;;
            esac
        done
        [[ $matched -eq 1 ]] || continue
        matched_pids+=("$pid")
        kill "$pid" >/dev/null 2>&1 || true
    done

    local alive=0 attempt
    for ((attempt = 0; attempt < 50; attempt++)); do
        alive=0
        for pid in "${matched_pids[@]}"; do
            if _runtime_process_matches "$pid"; then
                alive=1
                break
            fi
        done
        [[ $alive -eq 0 ]] && return 0
        sleep 0.1
    done

    # A graceful shutdown is preferred, but uninstall must not leave a
    # privileged relay alive while its pins and runtime files are removed.
    for pid in "${matched_pids[@]}"; do
        _runtime_process_matches "$pid" && kill -KILL "$pid" >/dev/null 2>&1 || true
    done
}

run_uninstall() {
    require_root "uninstall"

    local -a uninstall_ifaces=()
    if [[ $# -gt 0 ]]; then
        uninstall_ifaces=("$@")
    elif declare -p IFACES >/dev/null 2>&1 && declare -p IFACES 2>/dev/null | grep -q '^declare -a'; then
        uninstall_ifaces=("${IFACES[@]}")
    else
        read -r -a uninstall_ifaces <<< "${IFACES:-${IFACE:-}}"
    fi
    if [[ ${#uninstall_ifaces[@]} -eq 0 ]]; then
        printf 'Cannot determine protected interfaces. Retry with: sudo axdp uninstall IFACE...\n' >&2
        return 1
    fi

    if command -v systemctl >/dev/null 2>&1; then
        systemctl disable --now "$SERVICE_NAME" "$RELAY_SERVICE_NAME" >/dev/null 2>&1 || true
    fi
    if command -v rc-service >/dev/null 2>&1; then
        rc-service "$SERVICE_NAME" stop >/dev/null 2>&1 || true
        rc-service "$RELAY_SERVICE_NAME" stop >/dev/null 2>&1 || true
    fi
    if command -v rc-update >/dev/null 2>&1; then
        rc-update del "$SERVICE_NAME" default >/dev/null 2>&1 || true
        rc-update del "$RELAY_SERVICE_NAME" default >/dev/null 2>&1 || true
    fi
    _stop_runtime_processes

    local iface failures=0
    if ! command -v ip >/dev/null 2>&1; then
        printf 'ip command is required to detach XDP programs.\n' >&2
        return 1
    fi
    for iface in "${uninstall_ifaces[@]}"; do
        [[ -n "$iface" ]] || continue
        if ! ip link show dev "$iface" >/dev/null 2>&1; then
            continue
        fi
        ip link set dev "$iface" xdp off >/dev/null 2>&1 || true
        ip link set dev "$iface" xdpgeneric off >/dev/null 2>&1 || true
        ip link set dev "$iface" xdpoffload off >/dev/null 2>&1 || true
        if ip -d link show dev "$iface" 2>/dev/null \
                | grep -Eq 'prog/xdp|xdpgeneric|xdpoffload|(^|[[:space:]])xdp([[:space:]]|$)'; then
            printf 'Failed to detach XDP from %s.\n' "$iface" >&2
            failures=1
        fi

    done

    if command -v nft >/dev/null 2>&1; then
        nft delete table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1 || true
        if nft list table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1; then
            printf 'Failed to remove nftables table %s %s.\n' "$NFT_FAMILY" "$NFT_TABLE" >&2
            failures=1
        fi
    else
        printf 'nft command is required to verify removal of the fallback table.\n' >&2
        failures=1
    fi

    if [[ $failures -ne 0 ]]; then
        printf 'Uninstall stopped before deleting runtime files so it can be retried safely.\n' >&2
        return 1
    fi

    _remove_owned_tree "${BPF_PIN_DIR}_next" "xdp_fw_next" || failures=1
    _remove_owned_tree "${BPF_PIN_DIR}_rollback" "xdp_fw_rollback" || failures=1
    _remove_owned_tree "$BPF_PIN_DIR" "xdp_fw" || failures=1

    _remove_owned_file "$SYSTEMD_UNIT_DIR/${SERVICE_NAME}.service" "${SERVICE_NAME}.service" || failures=1
    _remove_owned_file "$SYSTEMD_UNIT_DIR/${RELAY_SERVICE_NAME}.service" "${RELAY_SERVICE_NAME}.service" || failures=1
    _remove_owned_file "$OPENRC_INIT_DIR/$SERVICE_NAME" "$SERVICE_NAME" || failures=1
    _remove_owned_file "$OPENRC_INIT_DIR/$RELAY_SERVICE_NAME" "$RELAY_SERVICE_NAME" || failures=1
    _remove_owned_file "$OPENRC_RUN_DIR/${SERVICE_NAME}.pid" "${SERVICE_NAME}.pid" || failures=1
    _remove_owned_file "$OPENRC_RUN_DIR/${RELAY_SERVICE_NAME}.pid" "${RELAY_SERVICE_NAME}.pid" || failures=1
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi

    _remove_owned_tree "$INSTALL_ROOT" "auto_xdp" || failures=1
    _remove_owned_tree "$RUN_STATE_DIR" "auto_xdp" || failures=1
    _remove_owned_relay_group || failures=1
    _remove_owned_tree "$CONFIG_DIR" "auto_xdp" || failures=1
    _remove_owned_file "$AXDP_CMD" "axdp" || failures=1

    if [[ $failures -ne 0 ]]; then
        printf 'Auto XDP uninstall completed with errors.\n' >&2
        return 1
    fi
    printf 'Auto XDP has been completely uninstalled.\n'
}

ensure_installed() {
    local path="$1"
    [[ -x "$path" ]] || {
        echo "Missing executable: $path" >&2
        exit 1
    }
}


load_config() {
    local cli_iface="$IFACE"
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1091
        source "$CONFIG_FILE"
    fi
    if [[ -n "$cli_iface" ]]; then
        IFACE="$cli_iface"
    fi
}

# Fail fast with a uniform hint when a state-changing subcommand runs without
# root, instead of surfacing a Python traceback from whichever layer hits
# EPERM first (config rewrite, pinned map access, systemctl, ...).
require_root() {
    [[ ${EUID:-$(id -u)} -eq 0 ]] && return 0
    printf 'axdp %s needs root; try: sudo axdp %s\n' "$*" "$*" >&2
    exit 77
}

# Drop CWD from sys.path before delegating to a module so an `auto_xdp/`
# directory in the caller's working directory cannot shadow the installed package.
PY_BOOTSTRAP='import sys, runpy; sys.path[:] = [p for p in sys.path if p]; runpy.run_module(sys.argv.pop(1), run_name="__main__", alter_sys=True)'

run_py_module() {
    local module="$1"
    shift
    PYTHONPATH="${PYTHON_LIB_DIR}" python3 -c "$PY_BOOTSTRAP" "$module" "$@"
}

require_admin_cli_runtime() {
    local command="$1"

    if PYTHONPATH="${PYTHON_LIB_DIR}" python3 -c '
import sys
sys.path[:] = [p for p in sys.path if p]

try:
    from auto_xdp import admin_cli
    parser = admin_cli.build_parser()
except Exception:
    raise SystemExit(1)

required_options = {"--run-state-dir", "--nft-family", "--nft-table", "--iface"}
if not required_options.issubset(set(parser._option_string_actions)):
    raise SystemExit(1)

command_action = next(
    (action for action in parser._actions if getattr(action, "dest", None) == "command"),
    None,
)
choices = set(getattr(command_action, "choices", {}) or {})
if sys.argv[1] not in choices:
    raise SystemExit(1)
' "$command" >/dev/null 2>&1; then
        return 0
    fi

    printf 'Installed auto_xdp Python support package is too old for: axdp %s\n' "$command" >&2
    printf 'Refresh the installed package and wrapper with: sudo axdp check-update --force\n' >&2
    printf 'Or reinstall from this checkout with: bash setup_xdp.sh --force\n' >&2
    exit 1
}

run_admin_config() {
    run_py_module auto_xdp.admin_cli \
        --config "$TOML_CONFIG" \
        --bpf-pin-dir "$BPF_PIN_DIR" \
        --install-dir "$INSTALL_DIR" \
        --handlers-dir "$HANDLERS_DIR" \
        --run-state-dir "$RUN_STATE_DIR" \
        "$@"
}

run_admin_runtime() {
    run_py_module auto_xdp.admin.main \
        --env-config "$CONFIG_FILE" \
        --bpf-pin-dir "$BPF_PIN_DIR" \
        --run-state-dir "$RUN_STATE_DIR" \
        --nft-family "$NFT_FAMILY" \
        --nft-table "$NFT_TABLE" \
        "$@"
}

run_log_level() {
    local level="${1:-}"

    if [[ -z "$level" ]]; then
        run_admin_config log-level
        return $?
    fi

    require_root "log-level $level"
    [[ -f "$TOML_CONFIG" ]] || run_config init
    run_admin_config log-level "$level"
    reload_daemon
    return 0
}

run_under_attack() {
    local mode="${1:-}"

    if [[ -z "$mode" ]]; then
        run_admin_config under-attack
        return $?
    fi

    require_root "under-attack $mode"
    [[ -f "$TOML_CONFIG" ]] || run_config init
    run_admin_config under-attack "$mode"
    reload_daemon
    return 0
}

run_backend() {
    run_admin_runtime backend "$@"
}

run_ports() {
    require_admin_cli_runtime ports

    local args=()
    for arg in "$@"; do
        [[ "$arg" == "watch" ]] && arg="--watch"
        args+=("$arg")
    done
    run_py_module auto_xdp.admin_cli \
        --config "$TOML_CONFIG" \
        --bpf-pin-dir "$BPF_PIN_DIR" \
        --install-dir "$INSTALL_DIR" \
        --run-state-dir "$RUN_STATE_DIR" \
        --nft-family "$NFT_FAMILY" \
        --nft-table "$NFT_TABLE" \
        ports "${args[@]}"
}

run_exposure() {
    require_admin_cli_runtime exposure
    run_admin_config exposure "$@"
}

run_explain() {
    require_admin_cli_runtime explain
    run_admin_config explain "$@"
}

run_stats() {
    require_admin_cli_runtime stats

    run_py_module auto_xdp.admin_cli \
        --config "$TOML_CONFIG" \
        --bpf-pin-dir "$BPF_PIN_DIR" \
        --install-dir "$INSTALL_DIR" \
        --run-state-dir "$RUN_STATE_DIR" \
        --nft-family "$NFT_FAMILY" \
        --nft-table "$NFT_TABLE" \
        --iface "${IFACES:-${IFACE:-}}" \
        stats "$@"
}

run_tui() {
    require_admin_cli_runtime tui

    run_py_module auto_xdp.admin_cli \
        --config "$TOML_CONFIG" \
        --bpf-pin-dir "$BPF_PIN_DIR" \
        --install-dir "$INSTALL_DIR" \
        --run-state-dir "$RUN_STATE_DIR" \
        --nft-family "$NFT_FAMILY" \
        --nft-table "$NFT_TABLE" \
        --iface "${IFACES:-${IFACE:-}}" \
        tui "$@"
}

run_check_update() {
    local force=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=1; shift ;;
            -h|--help)
                printf 'Usage: axdp check-update [--force]\n'
                printf '  --force   Apply all updates without prompting\n'
                exit 0
                ;;
            *)
                printf 'Unknown option: %s\n' "$1" >&2
                exit 1
                ;;
        esac
    done

    command -v curl >/dev/null 2>&1 || { printf 'curl is required for check-update\n' >&2; exit 1; }
    command -v python3 >/dev/null 2>&1 || { printf 'python3 is required for check-update\n' >&2; exit 1; }

    local ref_url="https://api.github.com/repos/Kookiejarz/Auto_XDP/commits/main"
    local source_ref
    source_ref=$(curl --proto '=https' --proto-redir '=https' --tlsv1.2 -sSfL "$ref_url" \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["sha"])') \
        || { printf 'Failed to resolve the main branch commit\n' >&2; exit 1; }
    [[ "$source_ref" =~ ^[0-9a-fA-F]{40}$ ]] \
        || { printf 'GitHub returned an invalid commit SHA\n' >&2; exit 1; }
    local setup_url="https://raw.githubusercontent.com/Kookiejarz/Auto_XDP/${source_ref}/setup_xdp.sh"
    local tmp_setup
    tmp_setup=$(mktemp)
    trap 'rm -f "$tmp_setup"' EXIT

    printf 'Fetching setup_xdp.sh from GitHub...\n'
    if ! curl --proto '=https' --tlsv1.2 -sSfL "$setup_url" -o "$tmp_setup"; then
        printf 'Failed to fetch setup_xdp.sh\n' >&2
        exit 1
    fi

    if [[ $force -eq 1 ]]; then
        AUTO_XDP_SOURCE_REF="$source_ref" AUTO_XDP_FORCE_REMOTE=1 \
            bash "$tmp_setup" --check-update --force
    else
        AUTO_XDP_SOURCE_REF="$source_ref" AUTO_XDP_FORCE_REMOTE=1 \
            bash "$tmp_setup" --check-update
    fi
}


# TOML config management helpers
# Reload the running daemon via SIGHUP (no restart gap), or restart as fallback.
reload_daemon() {
    local pid
    if pid=$(systemctl show -p MainPID --value "$SERVICE_NAME" 2>/dev/null) && [[ "$pid" -gt 1 ]]; then
        kill -HUP "$pid" 2>/dev/null && return 0
    fi
    if command -v rc-service >/dev/null 2>&1; then
        rc-service "$SERVICE_NAME" restart 2>/dev/null && return 0
    fi
    command -v systemctl >/dev/null 2>&1 && systemctl restart "$SERVICE_NAME" 2>/dev/null || true
}

run_config() {
    local sub="${1:-show}"
    shift || true
    case "$sub" in
        show)
            run_admin_config config show "$@"
            ;;
        init)
            require_root "config init"
            run_admin_config config init "$@"
            ;;
        -h|--help)
            echo "Usage: axdp config show|init"
            ;;
        *)
            echo "Unknown config subcommand: $sub" >&2; exit 1 ;;
    esac
}

run_trust() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in add|del) require_root "trust $sub" ;; esac
    case "$sub" in
        list)
            run_admin_config trust list
            ;;
        add)
            [[ -f "$TOML_CONFIG" ]] || run_config init
            run_admin_config trust add "$@"
            reload_daemon
            ;;
        del)
            run_admin_config trust del "$@"
            reload_daemon
            ;;
        -h|--help)
            echo "Usage: axdp trust list|add CIDR [LABEL]|del CIDR"
            ;;
        *)
            echo "Unknown trust subcommand: $sub" >&2; exit 1 ;;
    esac
}

run_acl() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in add|del) require_root "acl $sub" ;; esac
    case "$sub" in
        list)
            run_admin_config acl list
            ;;
        add)
            [[ -f "$TOML_CONFIG" ]] || run_config init
            run_admin_config acl add "$@"
            reload_daemon
            ;;
        del)
            run_admin_config acl del "$@"
            reload_daemon
            ;;
        -h|--help)
            echo "Usage: axdp acl list|add PROTO CIDR PORT...|del PROTO CIDR"
            ;;
        *)
            echo "Unknown acl subcommand: $sub" >&2; exit 1 ;;
    esac
}

run_policy() {
    local sub="${1:-grants}"
    shift || true
    case "$sub" in
        grants)
            require_admin_cli_runtime policy
            run_admin_config policy grants "$@"
            ;;
        -h|--help)
            echo "Usage: axdp policy grants [--json]"
            ;;
        *)
            echo "Unknown policy subcommand: $sub" >&2; exit 1 ;;
    esac
}

run_approval() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        list|history)
            require_admin_cli_runtime approval
            require_root "approval $sub"
            run_admin_config approval "$sub" "$@"
            ;;
        request|approve|reject|revoke)
            require_admin_cli_runtime approval
            require_root "approval $sub"
            [[ -f "$TOML_CONFIG" ]] || run_config init
            run_admin_config approval "$sub" "$@"
            ;;
        -h|--help)
            echo "Usage: axdp approval list|history|request SUBJECT ZONE PROTO PORT...|approve ID|reject ID|revoke ID"
            ;;
        *)
            echo "Unknown approval subcommand: $sub" >&2; exit 1 ;;
    esac
}

run_approval_api() {
    require_admin_cli_runtime approval-api
    require_root "approval-api"
    run_admin_config approval-api "$@"
}

run_slot() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in load|unload) require_root "slot $sub" ;; esac

    case "$sub" in
        list|load|unload)
            run_admin_config slot "$sub" "$@"
            ;;
        *)
            echo "Usage: axdp slot list|load NAME|PROTO [PATH]|unload NAME|PROTO" >&2
            exit 1
            ;;
    esac
}

run_port_handler() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in load|unload) require_root "port-handler $sub" ;; esac

    case "$sub" in
        list|load|unload)
            run_admin_config port-handler "$sub" "$@"
            ;;
        *)
            echo "Usage: axdp port-handler list|load tcp|udp PORT PATH [--no-config-update]|unload tcp|udp PORT [--no-config-update]" >&2
            exit 1
            ;;
    esac
}

run_exclude() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        list)
            run_admin_config exclude list
            ;;
        port|ports)
            local action="${1:-}"
            shift || true
            case "$action" in
                add|del)
                    require_root "exclude port $action"
                    [[ -f "$TOML_CONFIG" ]] || run_config init
                    run_admin_config exclude port "$action" "$@"
                    reload_daemon
                    ;;
                *)
                    echo "Usage: axdp exclude port add|del PORT [PORT...]" >&2
                    exit 1
                    ;;
            esac
            ;;
        src)
            local action="${1:-}"
            shift || true
            case "$action" in
                add|del)
                    require_root "exclude src $action"
                    [[ -f "$TOML_CONFIG" ]] || run_config init
                    run_admin_config exclude src "$action" "$@"
                    reload_daemon
                    ;;
                *)
                    echo "Usage: axdp exclude src add|del CIDR [CIDR...]" >&2
                    exit 1
                    ;;
            esac
            ;;
        -h|--help)
            echo "Usage: axdp exclude list|port add|del PORT...|src add|del CIDR..."
            ;;
        *)
            echo "Unknown exclude subcommand: $sub" >&2; exit 1 ;;
    esac
}

main() {
    local cmd="${1:-stats}"

    load_config

    case "$cmd" in
        stats)
            shift || true
            run_stats "$@"
            ;;
        tui)
            shift || true
            run_tui "$@"
            ;;
        watch)
            shift || true
            run_stats --watch "$@"
            ;;
        ports)
            shift || true
            run_ports "$@"
            ;;
        exposure)
            shift || true
            run_exposure "$@"
            ;;
        explain)
            shift || true
            run_explain "$@"
            ;;
        backend)
            shift || true
            run_backend "$@"
            ;;
        sync)
            shift || true
            require_root "sync"
            ensure_installed "$RUNNER_SCRIPT"
            exec "$RUNNER_SCRIPT" --sync-once "$@"
            ;;
        check-update)
            shift || true
            run_check_update "$@"
            ;;
        log-level)
            shift || true
            run_log_level "$@"
            ;;
        under-attack)
            shift || true
            run_under_attack "$@"
            ;;
        config)
            shift || true
            run_config "$@"
            ;;
        trust)
            shift || true
            run_trust "$@"
            ;;
        acl)
            shift || true
            run_acl "$@"
            ;;
        policy)
            shift || true
            run_policy "$@"
            ;;
        approval)
            shift || true
            run_approval "$@"
            ;;
        approval-api)
            shift || true
            run_approval_api "$@"
            ;;
        slot)
            shift || true
            run_slot "$@"
            ;;
        port-handler)
            shift || true
            run_port_handler "$@"
            ;;
        exclude)
            shift || true
            run_exclude "$@"
            ;;
        status)
            shift || true
            run_status "$@"
            ;;
        start|stop|restart)
            shift || true
            require_root "$cmd"
            run_service_cmd "$cmd"
            ;;
        uninstall)
            shift || true
            run_uninstall "$@"
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            run_stats "$@"
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]:-}" == "$0" ]]; then
    main "$@"
fi
